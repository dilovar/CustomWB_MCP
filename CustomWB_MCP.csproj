<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Идентификатор для dotnet user-secrets (токен WB хранится там, не в коде). -->
    <UserSecretsId>customwb-mcp-secrets</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Тянет за собой основной ModelContextProtocol. Версию при необходимости подними до последней стабильной. -->
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.2.0" />
  </ItemGroup>

</Project>
